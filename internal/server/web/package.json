{
  "name": "telemux-web",
  "private": true,
  "type": "module",
  "description": "Веб-панель telemux (React 19 + antd 6 + Vite). Основа - панель форка 3x-ui (GPL-3.0).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "npx --yes -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript ../../../api/openapi.yaml -o src/api/generated/openapi.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.104.2",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "swagger-ui-react": "^5.33.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.15",
    "react-copy-to-clipboard": "^5.1.1",
    "react-inspector": "^9.0.0",
    "react-debounce-input": {
      "react": "^19.0.0"
    },
    "swagger-ui-react": {
      "js-yaml": "^4.3.2",
      "brace-expansion": "^5.0.9"
    },
    "remarkable": {
      "argparse": "^2.0.1"
    }
  }
}
