# etcd - DCS для Patroni на трёх машинах управления (по одному участнику на машину).
# См. docs/adr/0002-master-failover.md. Значения в <...> заменить.
# Кластер из трёх участников переживает потерю одного; участник без связи
# с большинством не обслуживает запись - на этом стоит fencing Patroni.

ETCD_NAME=<ps1>
ETCD_DATA_DIR=/var/lib/etcd

ETCD_LISTEN_PEER_URLS=https://<адрес-этой-машины>:2380
ETCD_LISTEN_CLIENT_URLS=https://<адрес-этой-машины>:2379,https://127.0.0.1:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://<адрес-этой-машины>:2380
ETCD_ADVERTISE_CLIENT_URLS=https://<адрес-этой-машины>:2379

ETCD_INITIAL_CLUSTER=ps1=https://<адрес-ps1>:2380,ps2=https://<адрес-ps2>:2380,ps3=https://<адрес-ps3>:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=telemux-etcd

# Между зарубежными машинами RTT десятки миллисекунд: дефолты (100 мс / 1 с)
# дают ложные перевыборы. heartbeat ~ RTT, election ~ 10 * heartbeat.
ETCD_HEARTBEAT_INTERVAL=250
ETCD_ELECTION_TIMEOUT=2500

# mTLS между участниками и для клиентов (Patroni).
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE=/etc/etcd/pki/ca.crt
ETCD_CERT_FILE=/etc/etcd/pki/server.crt
ETCD_KEY_FILE=/etc/etcd/pki/server.key
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/pki/ca.crt
ETCD_PEER_CERT_FILE=/etc/etcd/pki/peer.crt
ETCD_PEER_KEY_FILE=/etc/etcd/pki/peer.key

ETCD_AUTO_COMPACTION_RETENTION=1
