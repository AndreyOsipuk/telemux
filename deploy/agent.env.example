# Агент telemux на машине флота (telemux agent).
# Адреса мастера по приоритету через запятую. У релея - только адреса, доступные
# через туннели своих машин-выходов, без публичных адресов за рубежом.
TELEMUX_AGENT_MASTERS=
# Код этой машины (как в telemux target).
TELEMUX_AGENT_TARGET=
# Файл с токеном машины (telemux agent-token --target <код> на мастере), chmod 600.
TELEMUX_AGENT_TOKEN_FILE=/etc/telemux/agent.token
# users.toml telemt на машине.
TELEMUX_AGENT_USERS_FILE=/etc/telemt/users.toml
# Режим: compare - только сравнить и отчитаться, файл не меняется.
TELEMUX_AGENT_MODE=compare
# Через какой мост ходит агент (для отчёта), необязательно.
TELEMUX_AGENT_VIA=
