# Агент telemux на машине флота (telemux agent).
# Адреса мастера по приоритету через запятую. У релея - только адреса, доступные
# через туннели своих машин-выходов, без публичных адресов за рубежом. Запись
# "адрес|прокси" ведёт этот адрес через свой туннель, например:
# http://<выход-1>:18480|socks5://127.0.0.1:10873,http://<выход-2>:18480|socks5://127.0.0.1:10872
TELEMUX_AGENT_MASTERS=
# Код этой машины (как в telemux target).
TELEMUX_AGENT_TARGET=
# Файл с токеном машины (telemux agent-token --target <код> на мастере), chmod 600.
TELEMUX_AGENT_TOKEN_FILE=/etc/telemux/agent.token
# users.toml telemt на машине; none - telemt на машине нет. Машина без telemt и mtg
# (выход только с туннелем и мостом): оба файла none - агент только отчитывается о машине.
TELEMUX_AGENT_USERS_FILE=/etc/telemt/users.toml
# config.toml mtg-multi; none - mtg на машине не ведётся.
TELEMUX_AGENT_MTG_FILE=none
TELEMUX_AGENT_MTG_STATS_URL=http://127.0.0.1:8081/stats
TELEMUX_AGENT_MTG_UNIT=mtg-multi
# 1 - SIGHUP, если изменились только секреты (иначе рестарт).
TELEMUX_AGENT_MTG_HOT_RELOAD=1
# Режим: compare - только сравнить и отчитаться, файлы не меняются;
# apply - применять (users.toml + WEB-профили, проверка «telemt принял», откат).
TELEMUX_AGENT_MODE=compare
# Для apply: telemt.toml с WEB-профилями, API проверки и юнит telemt.
TELEMUX_AGENT_CONFIG_FILE=/etc/telemt/telemt.toml
TELEMUX_AGENT_STATE_URL=http://127.0.0.1:9091/v1/config/state?sections=access
TELEMUX_AGENT_TELEMT_UNIT=telemt
# Через какой мост ходит агент (для отчёта), необязательно.
TELEMUX_AGENT_VIA=
# sha256 сертификата мастера (вывод telemux tls-cert) для https-адресов мастера.
TELEMUX_AGENT_MASTER_PIN=
# Локальные проверки для отчёта о машине: имя=http://адрес[,...]. Проверка пройдена,
# если адрес ответил 2xx. На выходе с мостом: bridge=http://127.0.0.1:18480/healthz
TELEMUX_AGENT_CHECKS=
