# PostgreSQL 16 + Patroni в одном контейнере (docker-режим машины управления).
# Patroni сам запускает и останавливает postgres внутри контейнера, поэтому
# entrypoint образа postgres не используется.
FROM postgres:16

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && python3 -m venv /opt/patroni \
 && /opt/patroni/bin/pip install --no-cache-dir 'patroni[etcd3]==4.0.4' 'psycopg[binary]==3.2.3' \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/patroni/bin:$PATH
USER postgres
ENTRYPOINT ["patroni", "/etc/patroni/patroni.yml"]
