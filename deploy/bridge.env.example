# Мост telemux на машине-выходе (telemux bridge).
# Адрес, на который туннель доставляет запросы агента релея. Только loopback:
# мост не должен быть виден снаружи.
TELEMUX_BRIDGE_LISTEN=127.0.0.1:18480
# Адреса мастера по приоритету через запятую (машины-выходы видят друг друга напрямую).
TELEMUX_BRIDGE_MASTERS=
