# Конфигурация telemux (/etc/telemux/telemux.env). Читается systemd-юнитом.

# DSN локального PostgreSQL. Держать на loopback, наружу не открывать.
DATABASE_URL=postgres://telemux:CHANGE_ME@127.0.0.1:5432/telemux?sslmode=disable

# telemt machine-API ноды (локально).
TELEMT_API_URL=http://127.0.0.1:9091
# Значение заголовка Authorization (если в [server.api] задан auth_header).
TELEMT_API_AUTH=

# Адрес HTTP-демона (веб-морда + API). Держать за фаерволом/реверс-прокси.
TELEMUX_LISTEN=127.0.0.1:8080

# Авторизация панели. Если пароль пуст — auth ВЫКЛЮЧЕН (открытый режим за фаерволом).
TELEMUX_ADMIN_USER=admin
TELEMUX_ADMIN_PASSWORD=

# --- API для бота (/api/v1/users, /api/v1/revisions) ---
# Bearer-токен бота. Пусто - API доступно только по сессии панели.
TELEMUX_BOT_TOKEN=
# Лимит TCP-подключений на пользователя по умолчанию в users.toml.
TELEMUX_DEFAULT_MAX_CONNS=50

# --- Кластер и автоматическая смена мастера (docs/adr/0002-master-failover.md) ---
# Код этой машины; совпадает с name в patroni.yml.
TELEMUX_NODE_CODE=
# Bearer для межузловых запросов (heartbeat, пинг соседей). Одинаковый на всех машинах.
TELEMUX_CLUSTER_SECRET=
# Соседние голосующие машины (без себя): code=url,code=url. Пусто - одиночный режим.
TELEMUX_PEERS=
# REST локального Patroni. Пусто - условие «Patroni лидер» не проверяется.
TELEMUX_PATRONI_URL=http://127.0.0.1:8008
# Сколько primary может быть без кворума до fenced (меньше ttl Patroni).
TELEMUX_FENCE_AFTER=10s
# Сколько условия мастера должны держаться до получения роли (антифлаппинг).
TELEMUX_MASTER_HOLD=5s
# Период проверки роли.
TELEMUX_ROLE_INTERVAL=2s
# Роли приложений для PG-fence (read-only + обрыв сессий на fenced primary).
# Пусто - PG-fence выключен. Аварийно снять: telemux fence off.
TELEMUX_PG_FENCE_ROLES=

# --- mtg через мастер-панель 3x-ui (машины вида panel) ---
# Адрес мастер-панели (с базовым путём). Пусто - синхронизатор панели выключен.
TELEMUX_XUI_URL=
# Bearer-токен панели с правами admin.
TELEMUX_XUI_TOKEN=
# sha256 сертификата панели (самоподписанный по IP); пусто - обычная проверка цепочки.
TELEMUX_XUI_CERT_SHA256=
# 1 - снять защиту от массового удаления клиентов входа (только намеренно).
TELEMUX_XUI_ALLOW_MASS_REMOVE=

# --- API агентов по TLS для машин-выходов (только /v1/ и /healthz) ---
# Пусто - выключено. Пример: 0.0.0.0:8443 + фаервол только для IP машин-выходов.
TELEMUX_TLS_LISTEN=
# Сертификат: telemux tls-cert (печатает отпечаток для TELEMUX_AGENT_MASTER_PIN /
# TELEMUX_BRIDGE_MASTER_PIN). Один сертификат на все машины управления - при смене
# мастера отпечаток у агентов не меняется.
TELEMUX_TLS_CERT=/etc/telemux/tls/cert.pem
TELEMUX_TLS_KEY=/etc/telemux/tls/key.pem
