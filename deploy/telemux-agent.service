[Unit]
Description=telemux agent - сверяет состояние машины с мастером
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/telemux/agent.env
ExecStart=/usr/local/bin/telemux agent
Restart=always
RestartSec=5
# Система только для чтения, кроме конфигов telemt: в режиме apply агент заменяет
# users.toml и telemt.toml (рядом - .telemux-bak). В режиме compare он их только читает.
ProtectSystem=strict
ReadWritePaths=/etc/telemt
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
