[Unit]
Description=telemux agent - сверяет состояние машины с мастером
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/telemux/agent.env
ExecStart=/usr/local/bin/telemux agent
Restart=always
RestartSec=5
# Система только для чтения, кроме конфигов telemt и mtg-multi: в режиме apply агент
# заменяет users.toml, telemt.toml и config.toml mtg (рядом - .telemux-bak). В режиме
# compare он их только читает.
ProtectSystem=strict
ReadWritePaths=/etc/telemt /etc/mtg-multi
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
